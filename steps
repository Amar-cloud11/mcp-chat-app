model context protocol - MCP
# install uv
python -m pip install uv

# create the project
uv init weather
cd weather

# create + activate the venv
uv venv
.venv\Scripts\activate

# install the MCP SDK
uv add "mcp[cli]"  / uv add "mcp[cli]<2"

# create first server
 weather / server.py 

# to run py file excute the command in terminal 
uv run mcp dev weather.py

# to open inspector 
mcp dev weather.py

